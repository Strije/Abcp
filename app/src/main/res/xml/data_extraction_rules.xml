<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+: то же, что backup_rules.xml, — и для облачной копии, и для переноса на другой телефон.
   Сессия, токены и данные веб-чата не уходят с устройства; на новом телефоне клиент входит заново.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
