<?xml version="1.0" encoding="utf-8"?>
<!--
   Резервная копия Android 11 и старше. В копию не попадает ничего привязанного к клиенту и устройству:
   настройки (сессия abcp_session с паролем и токеном сервера, push-токены, отметки показанных уведомлений,
   снимок статусов заказов, адрес сервера), базы и файлы SDK (push, аналитика), данные веб-чата.
   На новом телефоне клиент просто входит заново.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="app_webview" />
</full-backup-content>
