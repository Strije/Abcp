# Скопировать в /etc/avtodrug-api.env, владелец root, права 600. В git — только этот пример.
ABCP_HOST=https://id25202.public.api.abcp.ru
# API-администратор ABCP (Панель управления → Персонал/API). Пароль — md5-хэш.
ABCP_ADMIN_LOGIN=
ABCP_ADMIN_MD5=
# Случайная строка 64 символа: openssl rand -hex 32
TOKEN_SECRET=
