# Скопировать в /etc/avtodrug-api.env, владелец root, права 600. В git — только этот пример.
ABCP_HOST=https://id25202.public.api.abcp.ru
# API-администратор ABCP (Панель управления → Персонал/API). Пароль — md5-хэш.
ABCP_ADMIN_LOGIN=
ABCP_ADMIN_MD5=
# Случайная строка 64 символа: openssl rand -hex 32
TOKEN_SECRET=
# Laximo (подбор по VIN / госномеру) — в приложении этого пароля нет
LAXIMO_USER=
LAXIMO_PASS=
# Автообновление: этот же токен — секрет APP_UPLOAD_TOKEN в GitHub. openssl rand -hex 32
APP_UPLOAD_TOKEN=
# Гостевой поиск: профиль цен для тех, кто не вошёл (пусто — поиск без входа выключен)
GUEST_PROFILE_ID=
# Лимит articles/info (картинки) в сутки — на тарифе магазина 10
ARTICLES_INFO_PER_DAY=10
STATE_DIR=/var/lib/avtodrug-api
APP_DIR=/var/lib/avtodrug-api/app
# Telegram-бот @av92_bot: заявки на доступ, рассылки, сбои. CHAT_ID — чат менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Push RuStore: консоль RuStore → Push-уведомления → проект (ID и сервисный токен)
RUSTORE_PROJECT_ID=
RUSTORE_PUSH_TOKEN=
RUSTORE_PUSH_HOST=https://vkpns.rustore.ru
# Раз в сколько секунд смотреть изменения заказов (0 — не смотреть)
ORDER_WATCH_INTERVAL=180
# Чат через Битрикс24: локальное приложение (client_id / client_secret), портал и внешний адрес сервера
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_DOMAIN=bitrix.freno.ru
PUBLIC_URL=
