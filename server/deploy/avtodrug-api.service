[Unit]
Description=Avtodrug API (прокси к админскому API ABCP для приложения)
After=network-online.target
Wants=network-online.target

[Service]
User=avtodrug
Group=avtodrug
WorkingDirectory=/opt/avtodrug-api
EnvironmentFile=/etc/avtodrug-api.env
# Слушаем только локально — наружу его отдаёт nginx с HTTPS (deploy/nginx-avtodrug-api.conf)
ExecStart=/opt/avtodrug-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 1 --proxy-headers --no-access-log
Restart=always
RestartSec=3
# Ограничения: сервису не нужны права сверх чтения своей папки
NoNewPrivileges=true
ProtectSystem=strict
# /var/lib/avtodrug-api — единственное, куда сервис пишет (заявки, push-токены, APK)
StateDirectory=avtodrug-api
StateDirectoryMode=0700
ProtectHome=true
PrivateTmp=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
