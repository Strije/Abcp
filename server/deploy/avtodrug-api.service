[Unit]
Description=Avtodrug API (прокси к админскому API ABCP для приложения)
After=network-online.target
Wants=network-online.target

[Service]
User=avtodrug
Group=avtodrug
WorkingDirectory=/opt/avtodrug-api
EnvironmentFile=/etc/avtodrug-api.env
# Слушаем только локально — наружу его отдаёт Caddy с HTTPS
ExecStart=/opt/avtodrug-api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --no-access-log
Restart=always
RestartSec=3
# Ограничения: сервису не нужны права сверх чтения своей папки
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
