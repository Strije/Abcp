# HTTPS-сертификат Caddy получит сам (Let's Encrypt), нужен DNS: api.avtodrug92.ru → IP сервера
api.avtodrug92.ru {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
	}
	# Логи без строки запроса — в ней не должно оказаться лишнего
	log {
		output file /var/log/caddy/avtodrug-api.log
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
			}
		}
	}
}
